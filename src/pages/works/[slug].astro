---
import WorkDossier from "../../components/WorkDossier.astro";
import { publishedWorks } from "../../data/works.mjs";
import "../../styles/work.css";

export function getStaticPaths() {
  return publishedWorks().map((work) => ({
    params: { slug: work.slug },
    props: { work }
  }));
}

const { work } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta
      name="description"
      content="Hybrid Sensation — a source-aware work dossier by Jakob la Cour."
    />
    <title>{work.title.value} — Jakob la Cour</title>
  </head>
  <body>
    <WorkDossier {work} />
  </body>
</html>
